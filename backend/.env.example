# Copy to .env and fill in. `.env` is gitignored and holds real secrets -
# don't commit it, and don't paste its contents anywhere.

# Postgres. The database must exist; migrations run on boot.
DATABASE_URL=postgres://user:password@localhost:5432/friends_calendar

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# The server the bot lives in. Friend sync and the weekly digest need it;
# without it those degrade rather than crash.
DISCORD_GUILD_ID=

# Where events get announced. Optional - the /server page can set this
# instead, and that takes precedence.
DISCORD_ANNOUNCEMENT_CHANNEL_ID=

# Signing key for session tokens. Any long random string.
JWT_SECRET=
JWT_EXPIRATION=604800

# Where the frontend runs. Used for the OAuth redirect *and* for CORS, so a
# wrong value here logs people in and then blocks every request after it.
FRONTEND_URL=http://localhost:1420

# Optional. Defaults to 127.0.0.1:8080. Set 0.0.0.0:8080 when something
# outside the container has to reach it (e.g. a tunnel on the host).
# BIND_ADDR=127.0.0.1:8080
