{
  // Why this file exists at all:
  //
  // `wrangler deploy` with no config detects SvelteKit, assumes you want
  // @sveltejs/adapter-cloudflare, and tries to convert the project via
  // `sv add` - which shells out to `yarn dlx`, a Yarn 2+ command that does
  // not exist in Yarn 1. The deploy died on `Command "dlx" not found`.
  //
  // We don't want that conversion regardless. adapter-static is the right
  // adapter here: the Tauri desktop app needs a plain static build, there
  // is no SSR, and every route is a SPA behind a JWT. Declaring the config
  // explicitly stops the auto-detection and just publishes what
  // `yarn build` already produced.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friends-calendar",
  "compatibility_date": "2026-09-16",

  // Storybook ships with the app at /storybook/, rather than as a second
  // Cloudflare project with its own API token. Wrangler runs this before
  // every `wrangler deploy` - i.e. *after* the dashboard's `yarn build` -
  // which matters: adapter-static empties build/ when it runs, so Storybook
  // has to be written into it afterwards, not before.
  //
  // Kept out of `yarn build` itself on purpose: that script also feeds the
  // Tauri bundle and the layout tests, and neither should carry a component
  // library. Storybook's output uses relative paths, so it works from a
  // subdirectory unchanged.
  "build": {
    "command": "yarn build:storybook --quiet --output-dir build/storybook"
  },

  // No "main": this is an assets-only deployment. Without a Worker script
  // Cloudflare serves the directory directly from its edge, which is all a
  // static SPA needs.
  "assets": {
    "directory": "./build",

    // Nothing is prerendered - `build/` holds exactly one HTML file - so
    // unknown paths must fall back to it or every route except `/` 404s on
    // a direct link or refresh.
    //
    // This is the ONLY mechanism to use here. A `_redirects` file with the
    // usual Pages SPA rule (`/*  /index.html  200`) is *rejected* by
    // Workers Assets, which fails the whole deploy:
    //
    //   Invalid _redirects configuration:
    //   Line 10: Infinite loop detected in this rule. This would cause a
    //   redirect to strip `.html` or `/index` and end up triggering this
    //   rule again. [code: 100324]
    //
    // Workers Assets normalises `/index.html` back to `/`, which re-matches
    // `/*`. That rule is canonical on Pages and invalid here, so the two
    // cannot be kept side by side "just in case" - static/_redirects was
    // deleted for exactly this reason. If this ever moves to Pages, add it
    // back then.
    "not_found_handling": "single-page-application"
  }
}
